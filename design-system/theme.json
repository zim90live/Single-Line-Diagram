{
  "$schema": "./theme.schema.json",
  "name": "AIDC Diagram Neutral Dark",
  "tokens": {
    "font-interface": { "type": "fontFamily", "value": "\"Google Sans Code Variable\", \"Google Sans Code\", \"PingFang SC\", \"Microsoft YaHei\", ui-monospace, monospace" },
    "font-mono": { "type": "fontFamily", "value": "var(--font-interface)" },
    "text-title": { "type": "dimension", "value": "1rem" },
    "text-body": { "type": "dimension", "value": "0.75rem" },
    "text-caption": { "type": "dimension", "value": "0.625rem" },
    "type-action": { "type": "font", "value": "500 var(--text-body) / 16px var(--font-interface)" },
    "type-value": { "type": "font", "value": "400 var(--text-body) / 16px var(--font-interface)" },
    "type-label": { "type": "font", "value": "500 var(--text-caption) / 14px var(--font-interface)" },
    "canvas": { "type": "color", "value": "#141518" },
    "canvas-deep": { "type": "color", "value": "#101114" },
    "panel": { "type": "color", "value": "rgba(27, 29, 32, 0.96)" },
    "panel-raised": { "type": "color", "value": "rgba(35, 37, 41, 0.98)" },
    "surface-control": { "type": "color", "value": "rgba(47, 49, 54, 0.84)" },
    "surface-control-hover": { "type": "color", "value": "rgba(58, 61, 66, 0.92)" },
    "surface-selected": { "type": "color", "value": "rgba(240, 241, 237, 0.12)" },
    "ink": { "type": "color", "value": "#f2f3ef" },
    "muted": { "type": "color", "value": "#b6b8b4" },
    "dim": { "type": "color", "value": "#858784" },
    "accent": { "type": "color", "value": "#f0f1ed" },
    "focus": { "type": "color", "value": "#e5e7e1" },
    "cooling": { "type": "color", "value": "#77b4bf" },
    "cooling-soft": { "type": "color", "value": "rgba(78, 145, 157, 0.16)" },
    "cooling-primary-cold": { "type": "color", "value": "#ffc800" },
    "cooling-primary-hot": { "type": "color", "value": "#ff6011" },
    "cooling-secondary-cold": { "type": "color", "value": "#0084ff" },
    "cooling-secondary-hot": { "type": "color", "value": "#00f074" },
    "connection-cooling-pipe-width": { "type": "dimension", "value": "2px" },
    "connection-cooling-pipe-shell-width": { "type": "dimension", "value": "10px" },
    "connection-cooling-pipe-shell-color": { "type": "color", "value": "#262626" },
    "connection-cooling-pipe-bridge-mask-width": { "type": "dimension", "value": "18px" },
    "connection-cooling-pipe-hit-width": { "type": "dimension", "value": "16px" },
    "electrical": { "type": "color", "value": "#d5b96f" },
    "electrical-soft": { "type": "color", "value": "rgba(181, 143, 65, 0.16)" },
    "error": { "type": "color", "value": "#df816f" },
    "error-soft": { "type": "color", "value": "rgba(223, 129, 111, 0.13)" },
    "warning": { "type": "color", "value": "#d9a464" },
    "alarm-critical": { "type": "color", "value": "#e36f62" },
    "alarm-major": { "type": "color", "value": "#dc934f" },
    "alarm-minor": { "type": "color", "value": "#d8bf63" },
    "success": { "type": "color", "value": "#8eac94" },
    "success-soft": { "type": "color", "value": "rgba(142, 172, 148, 0.13)" },
    "border-default": { "type": "color", "value": "rgba(235, 237, 232, 0.11)" },
    "border-strong": { "type": "color", "value": "rgba(235, 237, 232, 0.24)" },
    "divider": { "type": "color", "value": "rgba(235, 237, 232, 0.075)" },
    "overlay-backdrop": { "type": "color", "value": "rgba(4, 5, 7, 0.58)" },
    "radius-sm": { "type": "dimension", "value": "6px" },
    "radius-control": { "type": "dimension", "value": "8px" },
    "radius-panel": { "type": "dimension", "value": "12px" },
    "radius-pill": { "type": "dimension", "value": "999px" },
    "space-xs": { "type": "dimension", "value": "2px" },
    "space-sm": { "type": "dimension", "value": "8px" },
    "space-md": { "type": "dimension", "value": "12px" },
    "space-lg": { "type": "dimension", "value": "16px" },
    "control-height": { "type": "dimension", "value": "28px" },
    "field-height": { "type": "dimension", "value": "32px" },
    "icon-size": { "type": "dimension", "value": "16px" },
    "duration-standard": { "type": "duration", "value": "140ms" },
    "ease-out-quart": { "type": "cubicBezier", "value": "cubic-bezier(0.25, 1, 0.5, 1)" },
    "shadow-panel": { "type": "shadow", "value": "0 14px 34px rgba(0, 0, 0, 0.28)" }
  },
  "recipes": {
    "button-height": { "type": "dimension", "value": "var(--control-height)" },
    "button-padding-x": { "type": "dimension", "value": "var(--space-sm)" },
    "button-gap": { "type": "dimension", "value": "6px" },
    "button-radius": { "type": "dimension", "value": "var(--radius-control)" },
    "button-fg": { "type": "color", "value": "var(--muted)" },
    "button-bg": { "type": "color", "value": "var(--surface-control)" },
    "button-border": { "type": "color", "value": "var(--border-default)" },
    "button-hover-fg": { "type": "color", "value": "var(--ink)" },
    "button-hover-bg": { "type": "color", "value": "var(--surface-control-hover)" },
    "button-hover-border": { "type": "color", "value": "var(--border-strong)" },
    "button-focus": { "type": "color", "value": "var(--focus)" },
    "button-disabled-opacity": { "type": "number", "value": "0.45" },
    "button-icon-size": { "type": "dimension", "value": "var(--icon-size)" },
    "button-type": { "type": "font", "value": "var(--type-action)" },
    "button-primary-fg": { "type": "color", "value": "var(--canvas)" },
    "button-primary-bg": { "type": "color", "value": "var(--accent)" },
    "button-danger-fg": { "type": "color", "value": "var(--error)" },
    "button-danger-bg": { "type": "color", "value": "var(--error-soft)" },
    "icon-button-size": { "type": "dimension", "value": "var(--control-height)" },
    "field-gap": { "type": "dimension", "value": "6px" },
    "field-padding-x": { "type": "dimension", "value": "var(--space-md)" },
    "field-radius": { "type": "dimension", "value": "var(--radius-control)" },
    "field-label": { "type": "color", "value": "var(--muted)" },
    "field-value": { "type": "color", "value": "var(--ink)" },
    "field-bg": { "type": "color", "value": "var(--surface-control)" },
    "field-border": { "type": "color", "value": "var(--border-default)" },
    "field-hover-border": { "type": "color", "value": "var(--border-strong)" },
    "field-focus": { "type": "color", "value": "var(--focus)" },
    "field-label-type": { "type": "font", "value": "var(--type-label)" },
    "field-value-type": { "type": "font", "value": "var(--type-value)" },
    "status-height": { "type": "dimension", "value": "22px" }
  }
}
